{
  // TypeScript configuration for IDE and mocha support only. Not used for build.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "outDir": "tmp/dist",
    "types": ["node", "mocha"]
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}