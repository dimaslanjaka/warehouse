{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "node",
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2020", "ES2019"],
    "rootDir": "src"
  },
  "include": ["src/**.ts", "./*.json"],
  "exclude": ["node_modules"]
}
